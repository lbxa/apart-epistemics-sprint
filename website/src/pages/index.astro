---
import FindingsExplorer from "../components/FindingsExplorer.astro";
import ResearchFilm from "../components/ResearchFilm.astro";
import VeracityDemo from "../components/VeracityDemo.astro";
import CopyableCode from "../components/CopyableCode.astro";
import research from "../data/research.json";
import "../styles/global.css";

const reportTitle = "Macro-Epistemics";
const reportType = "Apart Research · AI × Epistemics Sprint";
const reportDate = "November 2026 · Research draft";
const authors = [
  { name: "Lucas Barbosa", affiliation: "NYU" },
  { name: "Stefan Gazzana", affiliation: "Roundarc" },
];
const description = "Can AI stand behind its answers? Try Veracity and explore our findings on confidence, challenges and evidence.";
const codeUrl = "https://github.com/lbxa/apart-epistemics-sprint";
const artifactButtons = [
  { label: "Read the paper", href: "/files/macro-epistemics-paper.pdf" },
  { label: "Try Veracity", href: "#demo" },
  { label: "Watch the film", href: "#film" },
  { label: "Explore the findings", href: "#explore" },
  { label: "Code", href: codeUrl },
];
const deepseekReview = research.pilot.find((row) => row.model === research.models[0].id && row.arm === "neutral");
const deepseekAudit = research.pilot.find((row) => row.model === research.models[0].id && row.arm === "source_audit");
if (!deepseekReview || !deepseekAudit) throw new Error("The admitted DeepSeek pilot comparison is missing.");
const citation = `@misc{barbosa2026macroepistemics,
  title = {Macro-Epistemics: Confidence Under Dispute},
  author = {Barbosa, Lucas and Gazzana, Stefan},
  year = {2026},
  version = {Draft 2026-11-16},
  note = {Apart AI x Epistemics Research Sprint. Frozen cohorts:
    sector-study-da7e42f28ba54247:v8;
    contract-micro-g9t35ump:v734},
  url = {https://github.com/lbxa/apart-epistemics-sprint}
}`;
---

<html lang="en" class="bg-stone-50">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content="Macro-Epistemics · Make AI Answerable" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#fafaf9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{reportTitle} · Make AI Answerable</title>
  </head>
  <body class="bg-stone-50 text-stone-950">
    <a href="#idea" class="skip-link">Skip to the research</a>
    <main class="min-h-screen bg-stone-50">
      <section class="mb-12 pt-8 md:pt-12">
        <div class="mx-auto max-w-3xl px-1">
          <header class="mb-12 pt-20">
              <div class="mb-14 space-y-2 text-center text-xs">
                <svg viewBox="0 0 22 12" aria-hidden="true" class="mx-auto mb-4 block h-3 w-auto text-sm leading-none text-stone-800" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 1.5C3.51 1.5 1.5 3.51 1.5 6C1.5 8.49 3.51 10.5 6 10.5C8.2 10.5 9.98 8.95 11 7C12.02 8.95 13.8 10.5 16 10.5C18.49 10.5 20.5 8.49 20.5 6C20.5 3.51 18.49 1.5 16 1.5C13.8 1.5 12.02 3.05 11 5C9.98 3.05 8.2 1.5 6 1.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <p class="uppercase">{reportType}</p>
                <p>{reportDate}</p>
              </div>

              <hr class="mb-0 w-full border-t-4 border-stone-950" />
              <h1 class="py-10 text-center text-4xl font-light tracking-tight [text-wrap:balance]">
                {reportTitle}
              </h1>
              <hr class="w-full border-t-2 border-stone-950" />
              <div class="mt-12 flex flex-wrap items-start justify-center gap-x-5 gap-y-4 text-center text-sm text-stone-600 md:mt-14">
                {
                  authors.map((author) => (
                    <span class="inline-flex flex-col items-center">
                      <span class="font-medium text-stone-900 underline underline-offset-4">{author.name}</span>
                      <span class="mt-1 text-stone-600">{author.affiliation}</span>
                    </span>
                  ))
                }
              </div>

              <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
                {
                  artifactButtons.map((entry) => (
                    <a href={entry.href} target={entry.href.startsWith("https:") || entry.href.endsWith(".pdf") ? "_blank" : undefined} rel={entry.href.startsWith("https:") || entry.href.endsWith(".pdf") ? "noopener noreferrer" : undefined} class="inline-flex items-center justify-center rounded-full border border-stone-300 bg-white px-4 py-2 text-center text-xs font-medium text-stone-800 transition-colors hover:border-stone-950 hover:bg-stone-950 hover:text-white">
                      {entry.label}
                    </a>
                  ))
                }
              </div>
          </header>
        </div>
      </section>

      <div class="research-content mx-auto max-w-3xl px-4 pb-20 md:px-1">
        <section id="idea" class="research-intro">
          <p class="eyebrow">Make AI Answerable</p>
          <h2>Can AI stand behind its answers?</h2>
          <p>We study what models say they know, what they defend, and whether the evidence agrees. <a href="https://veracity.lbxa.net/" target="_blank" rel="noopener noreferrer">Veracity</a> makes that test tangible: save an answer, challenge it, then check what survives.</p>
        </section>

        <VeracityDemo />

        <section id="explore" class="research-section">
          <p class="eyebrow">Early findings</p>
          <h2>Three things we learned.</h2>
          <div class="finding-list">
            <article>
              <h3>Confidence can outrun accuracy.</h3>
              <p>Mean confidence exceeded reference accuracy for four of five models in the selected legal tasks, and all five in science.</p>
            </article>
            <article>
              <h3>A jury’s agreement needs checking.</h3>
              <p><strong>{research.summary.juryDisagreements} of {research.summary.settledVerdicts}</strong> settled pilot verdicts upheld answers the benchmark marked wrong. There were 100 assigned branches and five without a verdict.</p>
            </article>
            <article>
              <h3>Different scrutiny can change an answer.</h3>
              <p>On one saved error, DeepSeek corrected itself in <strong>{deepseekReview.successes}/{deepseekReview.completed}</strong> neutral reviews and <strong>{deepseekAudit.successes}/{deepseekAudit.completed}</strong> source audits. Five repeats are not five independent cases.</p>
            </article>
          </div>
          <p class="figure-note">Initial study: {research.summary.initialCompleted}/{research.summary.initialAssigned} usable answers · {research.summary.sourceGroups} cases · {research.summary.modelCount} models · {research.summary.domainCount} domains. The legal pilot is a separate cohort. These findings do not establish general reliability.</p>
          <details class="research-detail">
            <summary>Explore the charts, uncertainty and sources</summary>
            <FindingsExplorer />
          </details>
        </section>

        <section id="film" aria-label="A two-minute introduction" class="film-section">
          <ResearchFilm />
          <p class="figure-note">The idea in two minutes · first-draft film.</p>
        </section>

        <section id="resources" class="research-section resources-section">
          <h2>A future we can question.</h2>
          <p>Our vision: claims you can inspect, evidence you can trace, and corrections others can learn from.</p>
          <nav class="resource-links" aria-label="Research resources">
            <a href="/files/macro-epistemics-paper.pdf" target="_blank" rel="noopener noreferrer">Paper ↗</a>
            <a href={codeUrl} target="_blank" rel="noopener noreferrer">Code ↗</a>
            <a href="/data/research.json" download>Data ↓</a>
            <a href="https://veracity.lbxa.net/" target="_blank" rel="noopener noreferrer">About Veracity ↗</a>
            <a href="https://arxiv.org/abs/2507.09972" target="_blank" rel="noopener noreferrer">Original framework ↗</a>
          </nav>
          <details id="citation" class="research-detail">
            <summary>Cite this research</summary>
            <CopyableCode code={citation} lang="bibtex" />
          </details>
        </section>
      </div>

      <footer class="border-t border-stone-200 py-8" aria-label="Research credits">
        <div class="mx-auto max-w-3xl px-4 text-center text-xs leading-relaxed text-stone-600">
          <p>Apart Research · AI × Epistemics Research Sprint · November 2026</p>
        </div>
      </footer>
    </main>
  </body>
</html>
